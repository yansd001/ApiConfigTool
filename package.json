{
  "name": "api-config-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Codex, Claude Code and Claude Desktop configuration and balance queries",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:renderer": "tsc --noEmit && vite build",
    "build": "tauri build --no-bundle",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:native": "node tests/native/smoke.mjs",
    "format": "prettier --write src tests *.json *.ts *.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  }
}
