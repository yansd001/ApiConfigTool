<Window x:Class="ApiConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Config Tool" Width="1180" Height="800" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#18181B">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#71717A"/>
        <SolidColorBrush x:Key="Line" Color="#E4E4E7"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#3F3F46"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F97316"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#18181B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#18181B"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#52525B"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F97316"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F97316"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/><Setter Property="IsTextSearchEnabled" Value="False"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <Border CornerRadius="7" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="White"/>
                <TextBox x:Name="PART_EditableTextBox" Margin="1,1,33,1" BorderThickness="0" Background="Transparent" Padding="11,8"/>
                <ToggleButton Width="32" HorizontalAlignment="Right" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#71717A"/></Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
                </Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="12,12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EDEDF0"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E4E4EA"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F97316"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#F5F5F7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="12,24,12,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,28"><Border Width="28" Height="28" CornerRadius="7" Background="#18181B"><TextBlock Text="⇄" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandLabel" Text="API Config" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="AppsLabel" Text="工作空间" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,10"/>
                    <RadioButton x:Name="CodexNav" GroupName="App" Style="{StaticResource Nav}" IsChecked="True" Checked="Navigation_Changed" ToolTip="Codex"><StackPanel Orientation="Horizontal"><TextBlock Text="⌘" FontSize="17" Width="26"/><TextBlock x:Name="CodexNavLabel" Text="Codex" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel></RadioButton>
                    <RadioButton x:Name="ClaudeNav" GroupName="App" Style="{StaticResource Nav}" Checked="Navigation_Changed" ToolTip="Claude Code"><StackPanel Orientation="Horizontal"><TextBlock Text="✳" FontSize="17" Foreground="#B66A4F" Width="26"/><TextBlock x:Name="ClaudeNavLabel" Text="Claude Code" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel></RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2" x:Name="SidebarFooter" Margin="10,0"><TextBlock Text="本地配置管理" Foreground="#52525B" FontSize="12"/><TextBlock Text="简单配置，随时切换" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" x:Name="MainLayout" Margin="28,24,28,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="PageTitle" Text="Codex" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="管理 API 配置，选择当前使用的服务。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
                <Button Grid.Column="1" x:Name="NewProfileButton" Content="＋  新增配置" Style="{StaticResource Primary}" VerticalAlignment="Center" Click="NewProfile_Click"/>
            </Grid>
            <Grid Grid.Row="1" x:Name="ProfilesPage">
                <Grid.RowDefinitions><RowDefinition x:Name="ProfileListRow" Height="*"/><RowDefinition x:Name="EditorRow" Height="0"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProfileListColumn" Width="300"/><ColumnDefinition x:Name="EditorColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="ProfilesPanel" Margin="0,0,20,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <DockPanel><TextBlock Text="已保存的配置" FontWeight="SemiBold"/><TextBlock x:Name="ProfileCountText" Text="0" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <Button x:Name="RefreshBalancesButton" DockPanel.Dock="Right" Content="刷新余额" Padding="8,5" FontSize="11" Click="RefreshBalances_Click" ToolTip="刷新 Codex 和 Claude Code 全部已保存配置；同一地址和 Key 合并查询。"/>
                            <CheckBox x:Name="AutoBalanceCheck" Content="每 5 分钟" IsChecked="True" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Checked="AutoBalance_Changed" Unchecked="AutoBalance_Changed" ToolTip="工具运行时自动刷新；关闭窗口后停止。"/>
                        </DockPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="ProfileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" CornerRadius="9" BorderThickness="1" BorderBrush="#E4E4E7" Background="White" Padding="16"><ContentPresenter/></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A1A1AA"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#71717A"/><Setter TargetName="Card" Property="Background" Value="#FAFAFA"/></Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/><Setter TargetName="Card" Property="Background" Value="#F0F7FF"/></DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                <DockPanel><Border DockPanel.Dock="Right" Background="#E8F7EE" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}"><TextBlock Text="已启用" FontSize="10" Foreground="#15803D"/></Border><TextBlock Text="{Binding Profile.Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding Profile.Name}"/></DockPanel>
                                <TextBlock Text="{Binding Profile.BaseUrl}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding Profile.BaseUrl}"/>
                                <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="启用" Padding="12,5" FontSize="12" Tag="{Binding Profile.Id}" IsEnabled="{Binding CanActivate}" Click="ActivateProfile_Click"/><TextBlock Text="{Binding Profile.Model}" Foreground="#52525B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/></DockPanel>
                                <Border BorderBrush="#E4E4E7" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0" ToolTip="{Binding BalanceTooltip}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BalanceSummary}" FontWeight="SemiBold" Foreground="#3F3F46" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BalanceDetail}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="EmptyProfiles" CornerRadius="9" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20" VerticalAlignment="Top"><StackPanel><TextBlock Text="还没有 API 配置" FontWeight="SemiBold"/><TextBlock Text="填写表单并保存，即可随时启用。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border x:Name="GptPanel" Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,8,0,0"><StackPanel><TextBlock Text="GPT 账号" FontWeight="SemiBold"/><TextBlock x:Name="CodexModeText" Text="使用 Codex 官方登录" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,10"/><Button x:Name="GptButton" Content="切换到 GPT 账号" Click="SwitchGpt_Click"/></StackPanel></Border>
                </Grid>
                <Border x:Name="EditorPanel" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="24" Background="White">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel><Button DockPanel.Dock="Right" x:Name="DeleteProfileButton" Content="删除" Padding="10,5" Foreground="#B91C1C" Click="DeleteProfile_Click"/><TextBlock x:Name="EditorTitle" Text="新增配置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock x:Name="EditorDescription" Text="保存到列表后，点击启用即可切换。" Foreground="{StaticResource Muted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                            <StackPanel x:Name="NameField"><TextBlock Text="配置名称（可选）" Style="{StaticResource Label}"/><TextBox x:Name="ProfileNameBox" AutomationProperties.Name="配置名称"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,12">
                            <RadioButton x:Name="BasicModeButton" GroupName="EditorMode" Content="基础配置" Style="{StaticResource Nav}" Padding="12,7" IsChecked="True" Checked="EditorMode_Changed"/>
                            <RadioButton x:Name="SourceModeButton" GroupName="EditorMode" Content="配置源码" Style="{StaticResource Nav}" Padding="12,7" Margin="8,4,0,4" Checked="EditorMode_Changed"/>
                        </StackPanel>
                        <ScrollViewer x:Name="BasicEditor" Grid.Row="2" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Base URL" Style="{StaticResource Label}"/><TextBox x:Name="BaseUrlBox" AutomationProperties.Name="Base URL"/>
                                <TextBlock Text="API Key" Style="{StaticResource Label}" Margin="0,18,0,7"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="API Key"/><TextBox x:Name="ApiKeyPlainBox" Visibility="Collapsed" AutomationProperties.Name="API Key 明文"/></Grid><CheckBox Grid.Column="1" x:Name="ShowKeyCheck" Content="显示" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/></Grid>
                                <TextBlock Text="模型名称" Style="{StaticResource Label}" Margin="0,18,0,7"/><ComboBox x:Name="ModelCombo" AutomationProperties.Name="模型名称"/>
                                <Button x:Name="FetchButton" Content="获取模型列表" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7" Click="Fetch_Click"/>
                                <TextBlock x:Name="CustomSourceHint" Text="已保存自定义源码；基础字段修改会同步到源码。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0"><StackPanel><Button x:Name="ImportProfileButton" Content="从本机配置导入" HorizontalAlignment="Left" Padding="10,6" Click="ImportProfile_Click"/><TextBlock x:Name="ConfigPathHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid x:Name="SourceEditor" Grid.Row="2" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10"><DockPanel><Button x:Name="ExpandSourceButton" DockPanel.Dock="Right" Content="展开编辑" Padding="9,5" Click="ExpandSource_Click"/><TextBlock x:Name="SourceFileLabel" Text="config.toml" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="完整配置（含明文密钥）。手动修改随当前配置保存，启用时写入整个文件。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                            <TextBox x:Name="SourceBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12" VerticalContentAlignment="Top" SpellCheck.IsEnabled="False" AutomationProperties.Name="配置源码"/>
                            <DockPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="ValidateSourceButton" DockPanel.Dock="Right" Content="校验配置" Padding="10,6" Click="ValidateSource_Click"/><TextBlock Text="Ctrl+A 全选 · Ctrl+Z 撤销" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
                        </Grid>
                        <WrapPanel Grid.Row="3" Margin="0,18,0,0"><Button x:Name="SaveProfileButton" Content="保存配置" Click="SaveProfile_Click" Margin="0,0,10,0"/><Button x:Name="SaveActivateButton" Content="保存并启用" Style="{StaticResource Primary}" Click="SaveActivate_Click"/></WrapPanel>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <Border x:Name="StatusBorder" Background="#F5F5F7" CornerRadius="7" Padding="12,10"><TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap" Foreground="#52525B"/></Border>
                <Expander Header="运行日志" Margin="0,10,0,0" Foreground="{StaticResource Muted}"><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,8,0,0"/></Expander>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
