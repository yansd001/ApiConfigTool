{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API Config Tool",
  "version": "1.0.0",
  "identifier": "com.yansd001.api-config-tool",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "API Config Tool",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "resources": ["../licenses/*.txt"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
